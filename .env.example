# SQLite for local development. Prisma reads this at generate/push time.
DATABASE_URL="file:./dev.db"

# Optional. The app runs fully without it: every AI-generated artefact ships in
# the seed, so `npm run dev` gives a populated site with zero API calls. Set a
# key to enable the live surfaces — concierge replies, natural-language trip
# search, operator listing extraction, rate negotiation drafts, and the
# `ai:generate` script.
# ANTHROPIC_API_KEY="sk-ant-..."
